{
  "name": "@local/safe-delete-guard",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Denies destructive delete commands before they run, and ships a trash overlay that groups recycled files by session / turn with per-entry retention, a draggable settings window, location migration and low-disk protection.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "safety",
    "delete",
    "guard"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParadoxFoehn/safe-delete-guard.git"
  },
  "homepage": "https://github.com/ParadoxFoehn/safe-delete-guard#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/**",
    "tools/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  }
}
